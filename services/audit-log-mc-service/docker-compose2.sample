# version: "3.9"

services:
  audit-log-mc-service:
    build: .
    container_name: audit-log-mc-service
    env_file:
      - .env
    ports:
      - "5001:5001"
    depends_on:
      audit-db:
        condition: service_healthy
      audit-redis:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - audit-network

