# Gunakan Node.js resmi yang ringan
FROM node:20-alpine

# Set working directory
WORKDIR /usr/src/app

# Set environment default
ENV NODE_ENV=production
ENV PORT=5001

# Copy package.json & package-lock.json
COPY package*.json ./

# Install PM2 global dan production dependencies
RUN npm install -g pm2 \
    && npm ci --omit=dev

# Copy semua source code
COPY . .

# Expose port
EXPOSE 5001

# Jalankan server dengan PM2 runtime
CMD ["pm2-runtime", "ecosystem.config.js", "--env", "production"]
