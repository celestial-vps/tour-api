# =====================
# APP
# =====================
PORT=5001
BASE_PATH=/api/v1
NODE_ENV=development

Title=Celestial Development - Sequelize API
Description=Celestial Development - Celestial App API.
Version=1.0

# =====================
# DATABASE (POSTGRES)
# =====================
dialect=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD="Serverh5n&*#"
DATABASE=audit_trail

# =====================
# REDIS
# =====================
REDIS_HOST=127.0.0.1       # Nama container Redis
REDIS_PORT=6379                # Internal Docker port
REDIS_PASSWORD=Serverh5n 
REDIS_URL=redis://:Serverh5n@127.0.0.1:6379


# =====================
# KAFKA
# =====================
KAFKA_CLIENT_ID=audit-trail-microservice
KAFKA_BROKERS=kafka-dev:9092
KAFKA_CONSUMER_GROUP=audit-log-group
KAFKA_TOPIC=audit-logs

# =====================
# AUDIT API (INTERNAL DOCKER)
# =====================
AUDIT_API_URL=http://audit-api-dev:5001/api/v1/audit-log


# =====================
# SECURITY
# =====================
SECREATKEY=celestial
RoleId=d976bbc0-ac2f-4397-91c3-160537f154ba
 
